rd no-print"><h2>2. Flujo de caja detallado</h2><div class="notice">Las filas reproducen la estructura financiera del archivo de origen. El simulador calcula automáticamente utilidad antes de impuestos, impuesto, utilidad después de impuestos y beneficios netos.</div><div class="tablewrap matrix"><table id="inputTable"></table></div><div class="actions" style="margin-top:12px"><button class="btn primary" id="run">Ejecutar simulación</button><button class="btn secondary" id="pdf">Generar / guardar PDF</button><button class="btn secondary" id="reset">Restablecer</button></div></section>
<section id="output"></section></main><script>
const $=id=>document.getElementById(id);const money=x=>new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',maximumFractionDigits:0}).format(x);const pct=x=>Number.isFinite(x)?(x*100).toFixed(2)+'%':'—';const num=x=>new Intl.NumberFormat('es-CO',{maximumFractionDigits:2}).format(x);const esc=s=>String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const rows=[
['rev','INGRESOS OPERACIONALES',80000000],['prod','(-) COSTOS DE PRODUCCIÓN',20000000],['sales','(-) COSTOS DE VENTAS',8000000],['fin','(-) COSTOS FINANCIEROS',3000000],['admin','(-) COSTOS ADMINISTRATIVOS',10000000],['depTech','(-) DEPRECIACIÓN TECNOLOGÍA',0],['depVeh','(-) DEPRECIACIÓN VEHÍCULOS',0],['depOffice','(-) DEPRECIACIÓN EQUIPO DE OFICINA',0],['depFurniture','(-) DEPRECIACIÓN MUEBLES Y ENSERES',0],['depComp','(-) DEPRECIACIÓN EQUIPO DE CÓMPUTO',0],['amort','(-) AMORTIZACIÓN DE INTANGIBLES',0],['invTech','(-) INVERSIÓN EN TECNOLOGÍA',0],['invVeh','(-) INVERSIÓN EN VEHÍCULOS',0],['invOffice','(-) INVERSIÓN EN EQUIPO DE OFICINA',0],['invFurniture','(-) INVERSIÓN EN MUEBLES Y ENSERES',0],['invComp','(-) INVERSIÓN EN EQUIPO DE CÓMPUTO',0],['invIntang','(-) INVERSIÓN EN ACTIVOS INTANGIBLES',0],['invReal','(-) INMOBILIARIO',80000000],['wcInv','(-) INVERSIÓN EN CAPITAL DE TRABAJO',20000000],['wcRec','(+) RECUPERACIÓN DE CAPITAL DE TRABAJO',0],['credit','(+) CRÉDITO',30000000],['debtAmort','(-) AMORTIZACIÓN DE LA DEUDA',8000000],['salvage','(+) VALOR DE DESECHO',0]
];
function buildTable(){let n=Math.max(1,Math.min(10,+$('years').value||3));let h='<thead><tr><th>Partida</th><th>Año 0</th>';for(let t=1;t<=n;t++)h+=`<th>Año ${t}</th>`;h+='</tr></thead><tbody>';for(const [id,label,def] of rows){h+=`<tr><td>${label}</td>`;for(let t=0;t<=n;t++){let v=(t===0&&(id.startsWith('inv')||id==='wcInv'||id==='credit'))?def:(t===1&&!id.startsWith('inv')&&id!=='wcInv'&&id!=='credit'?def:0);h+=`<td><input data-id="${id}" data-t="${t}" type="number" value="${v}"/></td>`}h+='</tr>'}h+=`<tr class="row-total"><td>IMPUESTO SOBRE LA RENTA (%)</td><td colspan="${n+1}"><input id="tax" type="number" step="0.1" value="35"/></td></tr></tbody>`;$('inputTable').innerHTML=h}
$('years').addEventListener('change',buildTable);buildTable();$('ciiu').addEventListener('blur',()=>{let q=ciiuProfile($('ciiu').value);if(q.sector)$('sector').value=q.sector;});
function ciiuProfile(code){code=String(code||'').replace(/\D/g,'');let n=code?parseInt(code.slice(0,2),10):null;if(!n)return{sector:null,label:'No especificado',source:'DANE CIIU Rev. 4 A.C.',growth:null};if(n>=1&&n<=3)return{sector:'primaria',label:'Sección A — Agricultura, ganadería, caza, silvicultura y pesca',source:'DANE CIIU Rev. 4 A.C.',growth:null};if(n>=5&&n<=9)return{sector:'primaria',label:'Sección B — Explotación de minas y canteras',source:'DANE CIIU Rev. 4 A.C.',growth:null};if(n>=10&&n<=33)return{sector:'industrial',label:'Sección C — Industrias manufactureras',source:'DANE CIIU Rev. 4 A.C.',growth:null};if(n>=35&&n<=39)return{sector:'servicios',label:'Secciones D–E — Energía, agua y saneamiento',source:'DANE CIIU Rev. 4 A.C.',growth:null};if(n>=41&&n<=43)return{sector:'construccion',label:'Sección F — Construcción',source:'DANE CIIU Rev. 4 A.C.',growth:null};if(n>=45&&n<=56)return{sector:'comercio',label:'Secciones G–I — Comercio, transporte, alojamiento y comidas',source:'DANE CIIU Rev. 4 A.C.',growth:null};if(n>=58&&n<=63)return{sector:'tecnologia',label:'Sección J — Información y comunicaciones',source:'DANE CIIU Rev. 4 A.C.',growth:null};if(n>=64&&n<=66)return{sector:'servicios',label:'Sección K — Actividades financieras y de seguros',source:'DANE CIIU Rev. 4 A.C.',growth:null};if(n===68)return{sector:'servicios',label:'Sección L — Actividades inmobiliarias',source:'DANE CIIU Rev. 4 A.C.',growth:null};if(n>=69&&n<=82)return{sector:'servicios',label:'Secciones M–N — Servicios profesionales, científicos, técnicos y administrativos',source:'DANE CIIU Rev. 4 A.C.',growth:null};if(n>=84&&n<=88)return{sector:'servicios',label:'Secciones O–Q — Administración pública, educación y salud',source:'DANE CIIU Rev. 4 A.C.',growth:null};if(n>=90&&n<=99)return{sector:'servicios',label:'Secciones R–U — Arte, entretenimiento y otros servicios',source:'DANE CIIU Rev. 4 A.C.',growth:null};return{sector:null,label:'Código fuera de la estructura reconocida en este motor',source:'DANE CIIU Rev. 4 A.C.',growth:null}}
function inputs(){return{project:$('project').value,sector:$('sector').value,n:+$('years').value,wacc:+$('wacc').value/100,finance:+$('financeRate').value/100,reinvest:+$('reinvestRate').value/100,mg:+$('macroGrowth').value/100,ipc:+$('ipc').value/100,ipp:+$('ipp').value/100,md:+$('macroDemand').value/100,tax:+$('tax').value/100,region:$('region').value,ciiu:$('ciiu').value,ciiuInfo:ciiuProfile($('ciiu').value),units:+$('units').value||0,unitPrice:+$('unitPrice').value||0,unitVarCost:+$('unitVarCost').value||0,capacity:+$('capacity').value||0,workers:+$('workers').value||0,recurring:+$('recurring').value/100||0} }
function matrix(){let p=inputs(),a={};for(const [id] of rows)a[id]=Array(p.n+1).fill(0);document.querySelectorAll('#inputTable input[data-id]').forEach(e=>a[e.dataset.id][+e.dataset.t]=+e.value||0);return a}
function calc(p,m){let cf=Array(p.n+1).fill(0), detail=[];for(let t=0;t<=p.n;t++){if(t===0){cf[t]=-(m.invTech[0]+m.invVeh[0]+m.invOffice[0]+m.invFurniture[0]+m.invComp[0]+m.invIntang[0]+m.invReal[0]+m.wcInv[0])+m.credit[0];detail.push({t,rev:0,op:0,ebit:0,ebt:0,tax:0,net:0,da:0,capex:Math.abs(cf[t]),wc:0,credit:m.credit[0],debt:0,salvage:0,cf:cf[t]});continue}let rev=m.rev[t],op=m.prod[t]+m.sales[t]+m.fin[t]+m.admin[t],da=m.depTech[t]+m.depVeh[t]+m.depOffice[t]+m.depFurniture[t]+m.depComp[t],ebit=rev-op-da,ebt=ebit-m.amort[t],tx=Math.max(0,ebt*p.tax),net=ebt-tx,capex=m.invTech[t]+m.invVeh[t]+m.invOffice[t]+m.invFurniture[t]+m.invComp[t]+m.invIntang[t]+m.invReal[t]+m.wcInv[t],recovery=m.wcRec[t]+m.salvage[t];cf[t]=net+da+m.amort[t]-capex+recovery+m.credit[t]-m.debtAmort[t];detail.push({t,rev,op,ebit,ebt,tax:tx,net,da,capex,wc:m.wcRec[t]-m.wcInv[t],credit:m.credit[t],debt:m.debtAmort[t],salvage:m.salvage[t],cf:cf[t]})}return{cf,detail}}
function npv(rate,cf){return cf.reduce((s,x,t)=>s+x/Math.pow(1+rate,t),0)}
function irrNewton(cf,guess=.1){let r=guess,rows=[];for(let i=0;i<1005;i++){let f=n