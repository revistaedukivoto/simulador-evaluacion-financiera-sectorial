pv(r,cf),d=cf.slice(1).reduce((s,x,t)=>s-(t+1)*x/Math.pow(1+r,t+2),0);if(!Number.isFinite(d)||Math.abs(d)<1e-14)break;let nr=r-f/d,err=Math.abs(nr-r);rows.push({i,r,f,d,nr,err});r=nr;if(!Number.isFinite(r)||r<=-0.999999)break;if(err<1e-10)break}return{r,rows,converged:rows.length>0&&rows[rows.length-1].err<1e-10}}
function irrBisection(cf){let lo=-.9999,hi=10,flo=npv(lo,cf),fhi=npv(hi,cf);if(flo*fhi>0)return null;for(let i=0;i<300;i++){let mid=(lo+hi)/2,f=npv(mid,cf);if(Math.abs(f)<1e-9)return mid;if(flo*f<=0){hi=mid;fhi=f}else{lo=mid;flo=f}}return(lo+hi)/2}
function mirr(cf,finance,reinvest){let n=cf.length-1;let pvNeg=cf.reduce((s,x,t)=>s+(x<0?x/Math.pow(1+finance,t):0),0);let fvPos=cf.reduce((s,x,t)=>s+(x>0?x*Math.pow(1+reinvest,n-t):0),0);return pvNeg<0&&fvPos>=0?Math.pow(fvPos/-pvNeg,1/n)-1:null}
function payback(cf,rate=0){let cum=cf[0];for(let t=1;t<cf.length;t++){let f=cf[t]/Math.pow(1+rate,t);if(cum+f>=0)return t-1+(-cum)/f;cum+=f}return Infinity}
function sectorName(s){return{primaria:'Sector primario',industrial:'Industria manufacturera',construccion:'Construcción',comercio:'Comercio',servicios:'Servicios',tecnologia:'Información y servicios tecnológicos'}[s]}
function sectorProfile(s){return{primaria:{name:'Sector primario',focus:'productividad física, rendimiento por unidad, precio de venta, costos de insumos y capital de trabajo',indicators:[['Productividad física','Producción por hectárea, tonelada, cabeza o unidad productiva.'],['Margen unitario','Ingreso por unidad menos costo variable unitario.'],['Capital de trabajo','Sensibilidad al ciclo de cosecha, inventarios y cuentas por cobrar.'],['Riesgo de precio','Alta sensibilidad a variaciones de precios de productos e insumos.']],macro:'Conviene contrastar crecimiento de la actividad, precios al productor y condiciones de oferta.'},industrial:{name:'Industria manufacturera',focus:'capacidad instalada, costos unitarios, margen de contribución, productividad y apalancamiento operativo',indicators:[['Utilización de capacidad','Relación entre producción efectiva y capacidad disponible.'],['Costo unitario','Costo total o variable por unidad producida.'],['Punto de equilibrio','Unidades y ventas necesarias para cubrir costos fijos.'],['Apalancamiento operativo','Sensibilidad del resultado ante cambios en ventas.']],macro:'Debe contrastarse la dinámica industrial y la presión de precios de insumos.'},construccion:{name:'Construcción',focus:'avance físico, costos directos, cronograma, capital de trabajo y riesgo de ejecución',indicators:[['Avance físico','Relación entre obra ejecutada y obra programada.'],['Margen de obra','Ingresos contractuales menos costos directos e indirectos.'],['Capital de trabajo','Necesidad de financiación durante la ejecución.'],['Desviación de costos','Sensibilidad ante materiales, mano de obra y plazo.']],macro:'Debe incorporarse la dinámica de construcción, costos de insumos y condiciones de financiación.'},comercio:{name:'Comercio',focus:'margen comercial, rotación de inventarios, capital de trabajo, ventas y rotación de activos',indicators:[['Margen comercial','Margen bruto sobre ventas.'],['Rotación de inventarios','Velocidad de conversión del inventario en ventas.'],['Capital de trabajo','Inventarios, proveedores y cuentas por cobrar.'],['Rotación de activos','Ventas generadas por unidad de activo.']],macro:'Debe contrastarse la dinámica del comercio y la demanda interna.'},servicios:{name:'Servicios',focus:'ingreso por trabajador, utilización de capacidad, costos laborales, margen y recurrencia de ingresos',indicators:[['Ingreso por trabajador','Ingresos generados por unidad de trabajo.'],['Utilización de capacidad','Uso efectivo de horas, cupos o infraestructura disponible.'],['Margen operativo','Resultado operativo sobre ingresos.'],['Recurrencia','Proporción de ingresos repetitivos o contractuales.']],macro:'La demanda de servicios y el empleo pueden ser variables explicativas relevantes.'},tecnologia:{name:'Información y servicios tecnológicos',focus:'crecimiento de usuarios, ingreso recurrente, inversión tecnológica, productividad y escalabilidad',indicators:[['Ingreso recurrente','Peso de ingresos periódicos sobre ingresos totales.'],['Costo de adquisición','Costo de captar nuevos clientes o usuarios.'],['Escalabilidad','Crecimiento de ingresos frente al crecimiento de costos.'],['Inversión tecnológica','Necesidad de actualización y reposición de activos digitales.']],macro:'Debe contrastarse la dinámica de información y comunicaciones y la demanda digital.'}}[s]||{name:sectorName(s),focus:'estructura de costos, demanda, productividad y capital de trabajo',indicators:[],macro:'Se requiere seleccionar la serie sectorial correspondiente.'}}
function status(value,criterion){return criterion(value)?'Favorable':'Desfavorable'}
function interpret(label,v,p,extra=''){let base='';if(label==='VAN')base=v>0?'El VAN es positivo: el proyecto crea valor presente al descontar los flujos al costo de capital seleccionado.':'El VAN es negativo: bajo los supuestos actuales, los flujos no compensan el capital invertido y su costo de oportunidad.';if(label==='TIR')base=v>p.wacc?'La TIR supera el WACC, por lo que la rentabilidad interna del proyecto cubre el costo de capital.':'La TIR no supera el WACC, por lo que la rentabilidad interna no compensa el costo de capital.';if(label==='TIRM')base=v>p.wacc?'La TIRM supera el costo de capital y ofrece una lectura favorable considerando reinversión y financiación.':'La TIRM no supera el costo de capital bajo las tasas seleccionadas.';if(label==='B/C')base=v>1?'Por cada peso de costo actualizado se obtiene más de un peso de beneficio actualizado.':'Los beneficios actualizados no superan los costos actualizados.';if(label==='Payback')base=v<=p.n?'La recuperación ocurre dentro del horizonte del proyecto.':'La recuperación no ocurre dentro del horizonte analizado.';if(label==='DSCR')base=v>=1.2?'La cobertura mínima del servicio de deuda es holgada en los periodos con deuda.':v>=1?'La deuda se cubre, pero con margen reducido.':'El flujo disponible no cubre adecuadamente el servicio de deuda.';if(label==='ROI')base=v>0?'El retorno neto acumulado es positivo frente al capital invertido.':'El retorno neto acumulado es negativo.';if(label==='ROE')base=v>p.wacc?'El rendimiento del patrimonio supera el costo de capital utilizado como referencia.':'El rendimiento del patrimonio no supera el costo de capital de referencia.';return base+' '+extra+' El resultado debe analizarse específicamente para '+sectorName(p.sector).toLowerCase()+', considerando demanda, estructura de costos, productividad, capital de trabajo y riesgo.'}
function scenario(p,m,f,label){let mm=structuredClone(m);let demandFactor=f*(1+p.md);for(let t=1;t<=p.n;t++){let macro=Math.pow(1+p.mg,t-1);mm.rev[t]*=demandFactor*macro;let costFactor=(1+p.ipc)*(1+p.ipp);mm.prod[t]*=Math.pow(costFactor,t-1)*(f===.85?1.10:f===1.15?.95:1);mm.sales[t]*=Math.pow(costFactor,t-1)*(f===.85?1.10:f===1.15?.95:1);mm