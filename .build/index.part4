.admin[t]*=Math.pow(1+p.ipc,t-1);mm.fin[t]*=Math.pow(1+p.ipc,t-1)}let c=calc(p,mm).cf,ir=irrNewton(c),r=ir.converged?ir.r:irrBisection(c);let pvB=c.slice(1).reduce((s,x,t)=>s+Math.max(0,x)/Math.pow(1+p.wacc,t+1),0),pvC=Math.abs(c[0])+c.slice(1).reduce((s,x,t)=>s+Math.max(0,-x)/Math.pow(1+p.wacc,t+1),0);return{label,cf:c,van:npv(p.wacc,c),tir:r,bc:pvC?pvB/pvC:null}}

function sensitivityMatrix(p,m){
  const vars=[
    {key:'revenue',label:'Ingresos',base:0.10,desc:'Cambio porcentual en ingresos operacionales'},
    {key:'cost',label:'Costos operativos',base:0.10,desc:'Cambio porcentual en costos de producción, ventas y administración'},
    {key:'wacc',label:'WACC',base:0.02,desc:'Cambio en puntos porcentuales de la tasa de descuento'},
    {key:'demand',label:'Demanda',base:0.10,desc:'Cambio porcentual en volumen/demanda'},
    {key:'unitCost',label:'Costo variable unitario',base:0.10,desc:'Cambio porcentual en costo variable unitario'}
  ];
  const out=[];
  for(const v of vars){
    const neg=structuredClone(m), pos=structuredClone(m);
    if(v.key==='revenue'||v.key==='demand') for(let t=1;t<=p.n;t++) neg.rev[t]*=(1-v.base); else if(v.key==='cost') for(let t=1;t<=p.n;t++){neg.prod[t]*=1+v.base;neg.sales[t]*=1+v.base;neg.admin[t]*=1+v.base} else if(v.key==='wacc'){}
    if(v.key==='unitCost'){const base=Math.max(0,p.unitVarCost);for(let t=1;t<=p.n;t++){const q=p.units*Math.pow(1+p.mg,t-1);pos.prod[t]+=q*base*v.base;neg.prod[t]=Math.max(0,neg.prod[t]-q*base*v.base)}}
    if(v.key==='revenue'||v.key==='demand') for(let t=1;t<=p.n;t++) pos.rev[t]*=(1+v.base); else if(v.key==='cost') for(let t=1;t<=p.n;t++){pos.prod[t]*=1+v.base;pos.sales[t]*=1+v.base;pos.admin[t]*=1+v.base}
    const low=calc(p,neg).cf, high=calc(p,pos).cf;
    const lowRate=v.key==='wacc'?p.wacc-v.base:p.wacc, highRate=v.key==='wacc'?p.wacc+v.base:p.wacc;
    const lowVan=npv(lowRate,low), highVan=npv(highRate,high), baseVan=npv(p.wacc,calc(p,m).cf);
    out.push({label:v.label,desc:v.desc,low:lowVan,high:highVan,impact:Math.max(Math.abs(lowVan-baseVan),Math.abs(highVan-baseVan))});
  }
  return out.sort((a,b)=>b.impact-a.impact);
}
function scenarioGrid(p,m){
  const defs=[['Adverso',.85,1.10],['Base',1,1],['Expansivo',1.15,.95]];
  return defs.map(([label,demand,cost])=>{let mm=structuredClone(m);for(let t=1;t<=p.n;t++){mm.rev[t]*=demand*Math.pow(1+p.mg,t-1);mm.prod[t]*=cost*Math.pow(1+p.ipp,t-1);mm.sales[t]*=cost*Math.pow(1+p.ipp,t-1);mm.admin[t]*=cost*Math.pow(1+p.ipc,t-1)}let c=calc(p,mm).cf,ir=irrNewton(c),tir=ir.converged?ir.r:irrBisection(c);return{label,van:npv(p.wacc,c),tir,cf:c}});
}
function integralMetrics(p,m,res){
  const d=res.detail, y1=d[1]||{}, inv=Math.abs(res.cf[0]), debt=m.credit[0]||0;
  const totalDebt=debt+m.debtAmort.slice(1).reduce((a,b)=>a+b,0), equity=Math.max(0,inv-debt);
  const ebitda=d.slice(1).reduce((s,x)=>s+x.ebit+x.da,0), ebit=d.slice(1).reduce((s,x)=>s+x.ebit,0);
  const interest=d.slice(1).reduce((s,x)=>s+m.fin[x.t],0), netIncome=d.slice(1).reduce((s,x)=>s+x.net,0);
  const fcf=d.slice(1).reduce((s,x)=>s+x.ebit*(1-p.tax)+x.da-x.capex-(m.wcInv[x.t]||0)+(m.wcRec[x.t]||0)+0,0);
  const fcfe=d.slice(1).reduce((s,x)=>s+x.net+x.da-x.capex-(m.wcInv[x.t]||0)+(m.wcRec[x.t]||0)+m.credit[x.t]-m.debtAmort[x.t],0);
  const roa=inv?netIncome/inv:null, roe=equity?netIncome/equity:null;
  const debtEquity=equity?debt/equity:null, debtEbitda=ebitda?debt/ebitda:null, leverage=equity?inv/equity:null;
  const intCoverage=interest>0?ebit/interest:null;
  const dscrs=m.debtAmort.slice(1).map((ds,i)=>ds>0?Math.max(0,res.cf[i+1]+ds)/ds:null).filter(Number.isFinite);
  const dscr=dscrs.length?Math.min(...dscrs):null;
  const fixed=(m.admin[1]||0)+(m.fin[1]||0), varCost=(m.prod[1]||0)+(m.sales[1]||0), revenue=m.rev[1]||0;
  const cm=revenue-varCost, cmr=revenue>0?cm/revenue:null, breakEven=cmr>0?fixed/cmr:null, marginSafety=revenue>0&&breakEven!==null?(revenue-breakEven)/revenue:null;
  const nopat=ebit*(1-p.tax), eva=nopat-inv*p.wacc;
  const target=1.2, annualService=dscrs.length?Math.max(0,...d.slice(1).map((x,i)=>Math.max(0,res.cf[i+1]+(m.debtAmort[i+1]||0))/target)):0;
  const r=p.finance, n=p.n, af=r>0?(1-Math.pow(1+r,-n))/r:n;
  const maxDebt=annualService*af;
  const rows=[
    ['VAN',npv(p.wacc,res.cf),'COP','Favorable si > 0','Crea valor presente frente al costo de capital.'],
    ['TIR',res.irr.r,'%',`Favorable si > ${pct(p.wacc)}`,'Compara la rentabilidad interna con el WACC.'],
    ['TIRM',mirr(res.cf,p.finance,p.reinvest),'%',`Favorable si > ${pct(p.wacc)}`,'Incorpora tasas de financiación y reinversión.'],
    ['Índice de rentabilidad',inv>0?(npv(p.wacc,res.cf)+inv)/inv:null,'x','Favorable si > 1','Relaciona valor presente generado con la inversión inicial.'],
    ['Relación beneficio/costo',(()=>{let b=res.cf.slice(1).reduce((s,x,t)=>s+Math.max(0,x)/Math.pow(1+p.wacc,t+1),0),c=inv+res.cf.slice(1).reduce((s,x,t)=>s+Math.max(0,-x)/Math.pow(1+p.wacc,t+1),0);return c?b/c:null})(),'x','Favorable si > 1','Compara beneficios y costos actualizados.'],
    ['ROA',roa,'%', 'Referencia: > 0','Rendimiento acumulado sobre los activos/inversión utilizada como proxy.'],
    ['ROE',roe,'%',`Referencia: > ${pct(p.wacc)}`,'Rendimiento acumulado del patrimonio inicial.'],
    ['Cobertura de intereses',intCoverage,'x','Favorable si > 3x; alerta 1–3x','Mide cuántas veces el EBIT cubre los intereses.'],
    ['Endeudamiento',inv?debt/inv:null,'%','Referencia: menor es menor riesgo','Proporción de la inversión inicial financiada con deuda.'],
    ['Deuda/Patrimonio',debtEquity,'x','Referencia: menor es menor riesgo','Mide apalancamiento financiero directo.'],
    ['Deuda/EBITDA',debtEbitda,'x','Referencia: < 3x orientativo','Indica años de EBITDA equivalentes a la deuda inicial.'],
    ['Apalancamiento',leverage,'x','Referencia: menor es menor riesgo','Activos/inversión sobre patrimonio.'],
    ['DSCR mínimo',dscr,'x','Favorable ≥ 1,2x','Cobertura mínima del servicio de deuda.'],
    ['Servicio deuda/FCF',fcf?m.debtAmort.slice(1).reduce((a,b)=>a+b,0)/Math.abs(fcf):null,'%','Referencia: menor es mejor','Peso acumulado del servicio de deuda frente al FCF.'],
    ['Capacidad máxima indicativa de endeudamiento',maxDebt,'COP','Debe superar deuda propuesta','Estimación basada en DSCR objetivo de 1,2x y anualidad a la tasa de financiación.'],
    ['EVA',eva,'COP','Favorable si > 0','Valor económico agregado después de remunerar el capital al WACC.'],
    ['Flujo de caja libre (FCF)',fcf,'COP','Favorable si > 0','Flujo disponible antes de financiación y después de inversión operativa.'],
    ['Flujo de caja para accionista (FCFE)',fcfe,'COP','Favorable si > 0','Flujo disponible para el patrimonio después de deuda.'],
    ['Punto de equilibrio',breakEven,'COP','Menor que ventas proyectadas','Nivel de ventas necesario para cubrir costos fijos.'],
    ['Margen de seguridad',marginSafety,'%','Favorable si > 0','Distancia relativa entre ventas proyectadas y punto de equilibrio.']
  ];
