if(v===null||!Number.isFinite(v))return 'N/A'; if(['VAN','EVA','FCF','FCFE'].includes(label))return v>0?'Favorable':'Desfavorable';if(['TIR','TIRM','ROE'].includes(label))return v>p.wacc?'Favorable':'Desfavorable';if(label==='Índice de rentabilidad'||label==='Relación beneficio/costo')return v>1?'Favorable':'Desfavorable';if(label==='DSCR mínimo')return v>=1.2?'Favorable':v>=1?'Alerta':'Desfavorable';if(label==='Cobertura de intereses')return v>=3?'Favorable':v>=1?'Alerta':'Desfavorable';if(label==='Punto de equilibrio')return v<revenue?'Favorable':'Desfavorable';if(label==='Margen de seguridad')return v>0?'Favorable':'Desfavorable';return 'Informativo';};
  return `<section class="card"><h2>7B. Evaluación financiera integral — v1.0</h2><p>Esta matriz integra rentabilidad, liquidez, estructura de capital, generación de caja y equilibrio operativo. Cada indicador conserva resultado, unidad, criterio y lectura contextual.</p><div class="tablewrap"><table><thead><tr><th>Indicador</th><th>Resultado</th><th>Unidad</th><th>Estado</th><th>Criterio / interpretación</th></tr></thead><tbody>${rows.map(x=>{let v=x[1], display=x[2]==='COP'?money(v):x[2]==='%'?pct(v):x[2]==='x'?num(v)+'x':x[2]==='%'?pct(v):num(v);return `<tr><td>${x[0]}</td><td>${display}</td><td>${x[2]}</td><td>${ref(x[0],v)}</td><td>${x[3]}. ${x[4]}</td></tr>`}).join('')}</tbody></table></div><div class="interp"><b>Diagnóstico integral:</b> ${npv(p.wacc,res.cf)>0?'El proyecto genera valor presente bajo el WACC seleccionado.':'El proyecto no genera valor presente bajo el WACC seleccionado.'} ${dscr===null?'No se identificó servicio de deuda en los periodos analizados.':dscr>=1.2?'La cobertura mínima de deuda es adecuada.':'La estructura de deuda presenta una alerta de cobertura.'} ${marginSafety!==null&&marginSafety>0?'Las ventas proyectadas superan el punto de equilibrio.':'El margen de seguridad requiere revisión.'}</div></section>`;
}
function mathProcedure(p,m,res){
  const cf=res.cf, r=p.wacc, n=p.n, inv=Math.abs(cf[0]);
  const van=npv(r,cf), tir=res.irr.r, tm=mirr(cf,p.finance,p.reinvest);
  const pvB=cf.slice(1).reduce((s,x,t)=>s+Math.max(0,x)/Math.pow(1+r,t+1),0);
  const pvC=inv+cf.slice(1).reduce((s,x,t)=>s+Math.max(0,-x)/Math.pow(1+r,t+1),0);
  const bc=pvC?pvB/pvC:null, pi=inv?(van+inv)/inv:null;
  const pay=payback(cf), payD=payback(cf,r);
  const d=res.detail, debt=m.credit[0]||0, equity=Math.max(0,inv-debt);
  const net=d.slice(1).reduce((s,x)=>s+x.net,0), ebit=d.slice(1).reduce((s,x)=>s+x.ebit,0), interest=d.slice(1).reduce((s,x)=>s+m.fin[x.t],0);
  const roa=inv?net/inv:null, roe=equity?net/equity:null, ebitda=d.slice(1).reduce((s,x)=>s+x.ebit+x.da,0);
  const intCov=interest?ebit/interest:null, debtEq=equity?debt/equity:null, debtEbitda=ebitda?debt/ebitda:null, lev=equity?inv/equity:null;
  const dscrs=m.debtAmort.slice(1).map((ds,i)=>ds>0?Math.max(0,cf[i+1]+ds)/ds:null).filter(Number.isFinite), dscr=dscrs.length?Math.min(...dscrs):null;
  const fcf=d.slice(1).reduce((s,x)=>s+x.ebit*(1-p.tax)+x.da-x.capex-(m.wcInv[x.t]||0)+(m.wcRec[x.t]||0),0);
  const fcfe=d.slice(1).reduce((s,x)=>s+x.net+x.da-x.capex-(m.wcInv[x.t]||0)+(m.wcRec[x.t]||0)+m.credit[x.t]-m.debtAmort[x.t],0);
  const debtService=m.debtAmort.slice(1).reduce((a,b)=>a+b,0), dsFcf=fcf?debtService/Math.abs(fcf):null;
  const revenue=m.rev[1]||0, variable=(m.prod[1]||0)+(m.sales[1]||0), fixed=(m.admin[1]||0)+(m.fin[1]||0), cm=revenue-variable, cmr=revenue?cm/revenue:null, be=cmr>0?fixed/cmr:null, ms=revenue&&be!==null?(revenue-be)/revenue:null;
  const nopat=ebit*(1-p.tax), eva=nopat-inv*r;
  const annualService=dscrs.length?Math.max(0,...d.slice(1).map((x,i)=>Math.max(0,cf[i+1]+(m.debtAmort[i+1]||0))/1.2)):0;
  const af=p.finance>0?(1-Math.pow(1+p.finance,-n))/p.finance:n, maxDebt=annualService*af;
  const sub=(formula,calc,meaning)=>`<details><summary>${meaning}</summary><div class="formula">${formula}</div><p><b>Sustitución:</b> ${calc}</p></details>`;
  const cfTerms=cf.map((x,i)=>`FC<sub>${i}</sub>=${money(x)}`).join(' ; ');
  const procedures=[];
  procedures.push(sub('VAN = Σ FCₜ/(1+WACC)ᵗ',`(${cf.map((x,i)=>`${money(x)}/(1+${pct(r)})<sup>${i}</sup>`).join(' + ')}) = <b>${money(van)}</b>`,`VAN — valor presente neto`));
  procedures.push(sub('TIR: encontrar r tal que 0 = Σ FCₜ/(1+r)ᵗ',`Se resuelve iterativamente con Newton-Raphson usando ${cfTerms}. Resultado: <b>${pct(tir)}</b>.`,`TIR — tasa interna de retorno`));
  procedures.push(sub('TIRM = (FV positivos / −PV negativos)<sup>1/n</sup> − 1',`PV negativos a ${pct(p.finance)} y FV positivos a ${pct(p.reinvest)} durante ${n} años → <b>${pct(tm)}</b>.`,`TIRM — tasa interna modificada`));
  procedures.push(sub('Índice de rentabilidad = (VAN + inversión inicial) / inversión inicial',`(${money(van)} + ${money(inv)}) / ${money(inv)} = <b>${num(pi)}</b> veces.`,`Índice de rentabilidad`));
  procedures.push(sub('B/C = PV(beneficios) / PV(costos)',`${money(pvB)} / ${money(pvC)} = <b>${num(bc)}</b>.`,`Relación beneficio/costo`));
  procedures.push(sub('ROI = flujo neto acumulado / inversión inicial',`${money(net+cf[0])} / ${money(inv)} = <b>${pct((net+cf[0])/inv)}</b>.`,`ROI`));
  procedures.push(sub('ROA = utilidad neta acumulada / activos o inversión inicial',`${money(net)} / ${money(inv)} = <b>${pct(roa)}</b>.`,`ROA`));
  procedures.push(sub('ROE = utilidad neta acumulada / patrimonio inicial',`${money(net)} / ${money(equity)} = <b>${pct(roe)}</b>.`,`ROE`));
  procedures.push(sub('Payback: acumulación de FC hasta recuperar la inversión',`El acumulado alcanza cero en aproximadamente <b>${Number.isFinite(pay)?pay.toFixed(2)+' años':'fuera del horizonte'}</b>.`,`Payback simple`));
  procedures.push(sub('Payback descontado: acumulación de FCₜ/(1+WACC)ᵗ',`Descontando al ${pct(r)}, la recuperación ocurre en <b>${Number.isFinite(payD)?payD.toFixed(2)+' años':'fuera del horizonte'}</b>.`,`Payback descontado`));
  procedures.push(sub('Cobertura de intereses = EBIT / intereses',`${money(ebit)} / ${money(interest)} = <b>${Number.isFinite(intCov)?num(intCov)+'x':'N/A'}</b>.`,`Cobertura de intereses`));
  procedures.push(sub('Endeudamiento = deuda inicial / inversión inicial',`${money(debt)} / ${money(inv)} = <b>${pct(inv?debt/inv:null)}</b>.`,`Endeudamiento`));
  procedures.push(sub('Deuda/Patrimonio = deuda / patrimonio',`${money(debt)} / ${money(equity)} = <b>${Number.isFinite(debtEq)?num(debtEq)+'x':'N/A'}</b>.`,`Deuda/Patrimonio`));
  procedures.push(sub('Deuda/EBITDA = deuda inicial / EBITDA acumulado',`${money(debt)} / ${money(ebitda)} = <b>${Number.isFinite(debtEbitda)?num(debtEbitda)+'x':'N/A'}</b>.`,`Deuda/EBITDA`));
  procedures.push(sub('Apalancamiento = activos o inversión / patrimonio',`${money(inv)} / ${money(equity)} = <b>${Number.isFinite(lev)?num(lev)+'x':'N/A'}</b>.`,`Apalancamiento`));
  procedures.push(sub('DSCR = flujo disponible para deuda / servicio de deuda',dscrs.length?`Los DSCR por periodo son ${dscrs.map(x=>num(x)+'x').join(', ')}; mínimo = <b>${num(dscr)}x</b>.`:'No exis