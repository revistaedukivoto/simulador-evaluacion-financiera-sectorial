te servicio de deuda en el flujo.','DSCR mínimo'));
  procedures.push(sub('Servicio deuda/FCF = servicio acumulado / FCF',`${money(debtService)} / ${money(Math.abs(fcf))} = <b>${Number.isFinite(dsFcf)?pct(dsFcf):'N/A'}</b>.`,`Servicio de deuda / FCF`));
  procedures.push(sub('FCF = NOPAT + depreciación/amortización − CAPEX − Δcapital de trabajo',`${money(fcf)} = <b>FCF acumulado</b>. NOPAT acumulado = ${money(nopat)}; CAPEX y capital de trabajo se toman del flujo calculado.`,`Flujo de caja libre`));
  procedures.push(sub('FCFE = utilidad neta + depreciación/amortización − CAPEX − ΔCT + deuda − amortización',`${money(fcfe)} = <b>FCFE acumulado</b>.`,`Flujo de caja para accionista`));
  procedures.push(sub('EVA = NOPAT − WACC × capital invertido',`${money(nopat)} − (${pct(r)} × ${money(inv)}) = <b>${money(eva)}</b>.`,`EVA`));
  procedures.push(sub('Punto de equilibrio = costos fijos / margen de contribución porcentual',`Margen de contribución = ${money(cm)}; margen porcentual = ${pct(cmr)}; costos fijos = ${money(fixed)} → <b>${money(be)}</b>.`,`Punto de equilibrio`));
  procedures.push(sub('Margen de seguridad = (ventas − punto de equilibrio) / ventas',`(${money(revenue)} − ${money(be)}) / ${money(revenue)} = <b>${pct(ms)}</b>.`,`Margen de seguridad`));
  procedures.push(sub('Capacidad máxima de endeudamiento = anualidad compatible con DSCR 1,2 × factor de anualidad',`Servicio anual de referencia = ${money(annualService)}; factor de anualidad = ${num(af)} → <b>${money(maxDebt)}</b>. Es una capacidad indicativa, no un límite crediticio bancario.`,`Capacidad máxima indicativa de endeudamiento`));
  return `<section class="card"><h2>7C. Procedimiento matemático de los indicadores</h2><p>Esta sección muestra la ecuación utilizada y la sustitución con los valores calculados del proyecto. Los resultados son reproducibles a partir del flujo de caja visible.</p>${procedures.join('')}<div class="interp"><b>Nota metodológica:</b> las fórmulas no se modifican por sector. El sector modifica supuestos, referencias, variables operativas y criterios de interpretación.</div></section>`;
}
function render(p,m,res){let cf=res.cf,van=npv(p.wacc,cf),tir=res.irr.r,tm=mirr(cf,p.finance,p.reinvest),pvBenefits=cf.slice(1).reduce((s,x,t)=>s+Math.max(0,x)/Math.pow(1+p.wacc,t+1),0),pvCosts=Math.abs(cf[0])+cf.slice(1).reduce((s,x,t)=>s+Math.max(0,-x)/Math.pow(1+p.wacc,t+1),0),bc=pvCosts>0?pvBenefits/pvCosts:null,pay=payback(cf),payD=payback(cf,p.wacc),netOperating=cf.slice(1).reduce((a,b)=>a+b,0),initialInvestment=Math.abs(cf[0])+m.credit[0],roi=initialInvestment>0?(netOperating+cf[0])/initialInvestment:null,equity=Math.max(1,Math.abs(cf[0])-m.credit[0]),roe=cf.slice(1).reduce((a,b)=>a+b,0)/equity,cfads=cf.slice(1).map((x,i)=>x+m.debtAmort[i+1]||x),dscrs=m.debtAmort.slice(1).map((ds,i)=>ds>0?(Math.max(0,cf[i+1])+ds)/ds:null).filter(x=>x!==null),dscr=dscrs.length?Math.min(...dscrs):null;let sc=[scenario(p,m,.85,'Pesimista'),scenario(p,m,1,'Base'),scenario(p,m,1.15,'Optimista')];let metrics=[['VAN',money(van),status(van,v=>v>0),interpret('VAN',van,p)],['TIR',pct(tir),status(tir,v=>v>p.wacc),interpret('TIR',tir,p)],['TIRM',pct(tm),status(tm,v=>v>p.wacc),interpret('TIRM',tm,p)],['B/C',num(bc),status(bc,v=>v>1),interpret('B/C',bc,p)],['Payback',Number.isFinite(pay)?pay.toFixed(2)+' años':'No recupera',status(pay,v=>v<=p.n),interpret('Payback',pay,p)],['Payback descontado',Number.isFinite(payD)?payD.toFixed(2)+' años':'No recupera',status(payD,v=>v<=p.n),interpret('Payback',payD,p,'El payback descontado incorpora el valor temporal del dinero.')],['ROI',pct(roi),status(roi,v=>v>0),interpret('ROI',roi,p,'Se calcula como flujo neto acumulado respecto de la inversión inicial total.')],['ROE acumulado',roe===null?'N/A':pct(roe),roe===null?'No aplicable':status(roe,v=>v>p.wacc),roe===null?'No existe patrimonio inicial positivo después de considerar la deuda.':interpret('ROE',roe,p,'El ROE se presenta como rendimiento acumulado sobre el patrimonio inicial.')],['DSCR mínimo',dscr===null?'N/A':num(dscr)+'x',dscr===null?'Sin deuda':dscr>=1.2?'Favorable':dscr>=1?'Alerta':'Desfavorable',dscr===null?'No se registra amortización de deuda; el indicador no es aplicable.':interpret('DSCR',dscr,p)]];
let details=metrics.map(x=>`<details><summary>${x[0]} — ${x[1]}</summary><div class="interp">${x[3]}</div></details>`).join('');let it=res.irr.rows.slice(0,30).map(x=>`<tr><td>${x.i}</td><td>${pct(x.r)}</td><td>${money(x.f)}</td><td>${num(x.d)}</td><td>${pct(x.nr)}</td><td>${x.err.toExponential(3)}</td></tr>`).join('');let scen=sc.map(x=>`<tr><td>${x.label}</td><td>${money(x.van)}</td><td>${pct(x.tir)}</td><td>${num(x.bc)}</td></tr>`).join('');let d=res.detail.map(x=>`<tr><td>${x.t}</td><td>${money(x.rev)}</td><td>${money(x.op)}</td><td>${money(x.da)}</td><td>${money(x.ebit)}</td><td>${money(x.tax)}</td><td>${money(x.net)}</td><td>${money(x.capex)}</td><td>${money(x.cf)}</td></tr>`).join('');return `<section class="card report"><h2>3. Resultado ejecutivo</h2><p class="small"><span class="badge">Motor v1.1</span> Contexto DANE incorporado como capa de referencia macroeconómica. Los datos oficiales se mantienen diferenciados de los supuestos editables del proyecto.</p><p><b>${esc(p.project)}</b> — ${sectorName(p.sector)}. Horizonte: ${p.n} años. WACC: ${pct(p.wacc)}; financiación TIRM: ${pct(p.finance)}; reinversión TIRM: ${pct(p.reinvest)}.</p><div class="metrics">${metrics.slice(0,4).map(x=>`<div class="metric"><div class="name">${x[0]}</div><div class="val">${x[1]}</div><div class="status ${x[2]==='Favorable'?'ok':x[2]==='Desfavorable'?'bad':'warn'}">${x[2]}</div></div>`).join('')}</div><h3>Interpretación de indicadores</h3>${details}</section>
<section class="card"><h2>4. Flujo de caja calculado</h2><div class="tablewrap"><table><thead><tr><th>Año</th><th>Ingresos</th><th>Costos operativos</th><th>Dep./amort.</th><th>EBIT</th><th>Impuesto</th><th>Utilidad neta</th><th>Inversión</th><th>Beneficio neto</th></tr></thead><tbody>${d}</tbody></table></div><h3>Trazabilidad con el modelo del Excel</h3><div class="formula">Utilidad antes de impuestos = Ingresos operacionales − costos de producción − costos de ventas − costos financieros − costos administrativos − depreciaciones − amortización de intangibles.<br>Impuesto = max(0, utilidad antes de impuestos × tasa de impuesto).<br>Beneficio neto = utilidad después de impuestos + depreciaciones + amortización − inversiones − capital de trabajo + recuperaciones + crédito − amortización de deuda + valor de desecho.</div></section>
<section class="card"><h2>5. Procedimiento matemático de la TIR</h2><div class="formula">VAN(r) = FC₀ + FC₁/(1+r) + FC₂/(1+r)² + … + FCₙ/(1+r)ⁿ<br>Newton-Raphson: rₖ₊₁ = rₖ − f(rₖ) / f'(rₖ)<br>f'(r) = −FC₁/(1+r)² − 2FC₂/(1+r)³ − … − nFCₙ/(1+r)ⁿ⁺¹</div><details open><summary>Ver iteraciones</summary><div class="tablewrap"><table><thead><tr><th>Iteración</th><th>Tasa actual</th><th>f(r)</th><th>f'(r)</th><th>Nueva tasa</th><th>Error</th></tr></thead><tbody>${it}</tbody></table></div></details></section>
<section class="card"><h2>6. Escenarios</h2><div class="tablewrap"><table><thead><tr><th>Escenario</th><th>VAN</th><th>TIR</th><th>B/C</th></tr></thead><tbody>${scen}</tbody></table></div><div class="two"><div class="canvasbox"><canvas id="scenarioChart" width="600" height="260"></canvas></div><div class="candle"><canvas id="candleChart" width="600" height="260"></canvas></div></div></section>
<section class="card"><h2>7. Sensibilidad</h2><div class="tablewrap"><table id="sensTable"></table></div><div class="interp">La sensibilidad muestra cómo cambia el VAN ante perturbaciones de ingresos, costos, demanda, costo variable y WACC. El orden de las variables se presenta por impacto absoluto sobre el VAN.</div></section>`+integralMetrics(p,m,res)+mathProcedure(p,m,res)+`<section class="card"><h2>8. Contexto macroeconómico y sectorial</h2><p>La información DANE se incorpora como referencia externa. Los supuestos editables se mantienen separados para garantizar trazabilidad y evitar que una cifra observada sea tratada automáticamente como una proyección financiera.</p><p><b>Sector:</b> ${esc(sectorName(p.sector))}. <b>CIIU:</b> ${esc(p.ciiuInfo.label)}. <b>Región:</b> ${esc(p.region)}.</p></section>`;}
function drawCharts(p,m,res){let sc=scenarioGrid(p,m);let c=document.getElementById('scenarioChart');if(c){let x=c.getContext('2d'),w=c.width,h=c.height;x.clearRect(0,0,w,h);let vals=sc.map(s=>s.van),max=Math.max(...vals,0),min=Math.min(...vals,0),range=max-min||1;x.beginPath();x.moveTo(40,10);x.lineTo(40,h-30);x.lineTo(w-10,h-30);x.stroke();sc.forEach((s,i)=>{let bx=80+i*170,by=h-30-(s.van-min)/range*(h-60);x.fillText(s.label,bx,h-10);x.fillText(money(s.van),bx,Math.max(15,by-5));x.fillRect(bx,Math.min(h-30,by),80,Math.abs((h-30)-by));});}let cc=document.getElementById('candleChart');if(cc){let x=cc.getContext('2d'),w=cc.width,h=cc.height;x.clearRect(0,0,w,h);x.strokeRect(30,20,w-50,h-50);let series=res.cf.slice(1);let lo=Math.min(...series),hi=Math.max(...series),range=hi-lo||1;series.forEach((v,i)=>{let xx=50+i*((w-80)/Math.max(1,series.length-1)),yy=h-30-(v-lo)/range*(h-70);x.beginPath();x.moveTo(xx,yy-20);x.lineTo(xx,yy+20);x.stroke();x.fillRect(xx-5,yy-10,10,20);});x.fillText('Rango de flujos por periodo',45,15);}}
function run(){try{let p=inputs(),m=matrix(),r=calc(p,m),ir=irrNewton(r.cf),fb=irrBisection(r.cf);r.irr={...ir,r:ir.converged?ir.r:fb};$('output').innerHTML=render(p,m,r);let sens=sensitivityMatrix(p,m);$('sensTable').innerHTML='<thead><tr><th>Variable</th><th>Escenario bajo</th><th>Escenario alto</th><th>Impacto VAN</th></tr></thead><tbody>'+sens.map(s=>`<tr><td>${s.label}</td><td>${money(s.low)}</td><td>${money(s.high)}</td><td>${money(s.impact)}</td></tr>`).join('')+'</tbody>';drawCharts(p,m,r)}catch(e){console.error(e);$('output').innerHTML=`<section class="card"><div class="interp"><b>Error de ejecución:</b> ${esc(e.message||e)}</div></section>`}}
$('run').addEventListener('click',run);$('pdf').addEventListener('click',openReport);const reportBtn=$('report');if(reportBtn)reportBtn.addEventListener('click',openReport);$('reset').addEventListener('click',()=>location.reload());run();
function openReport(){let el=document.getElementById('academicReport');if(!el){let p=inputs(),m=matrix(),r=calc(p,m),ir=irrNewton(r.cf),fb=irrBisection(r.cf);r.irr={...ir,r:ir.converged?ir.r:fb};let sc=scenarioGrid(p,m),html=academicReport(p,m,r,sc);let w=window.open('','_blank');if(!w){alert('El navegador bloqueó la ventana de informe. Permita ventanas emergentes para este sitio.');return}w.document.write('<!doctype html><html lang="es"><head><meta charset="utf-8"><title>Informe de evaluación financiera</title><style>body{font-family:Arial;margin:30px;color:#17212b}table{width:100%;border-collapse:collapse}th,td{border:1px solid #ccc;padding:6px;font-size:12px}th{background:#eee}.formula{background:#f5f5f5;padding:10px}.card{margin-bottom:24px}.interp{background:#f7f9fb;padding:10px}</style></head><body>'+html+'</body></html>');w.document.close();w.focus();setTimeout(()=>w.print(),400)}}
function metricsTable(p,m,res){let im=integralMetrics(p,m,res);return `<div class="tablewrap"><table><thead><tr><th>Indicador</th><th>Resultado</th><th>Unidad</th><th>Criterio</th><th>Lectura</th></tr></thead><tbody>${im.match(/<tbody>(.*?)<\/tbody>/s)?.[1]||''}</tbody></table></div>`}
function academicReport(p,m,res,sc){let van=npv(p.wacc,res.cf),tir=res.irr.r,tm=mirr(res.cf,p.finance,p.reinvest),status=van>0&&tir>p.wacc?'VIABLE':'REQUIERE AJUSTES';let rows=res.detail.map(x=>`<tr><td>${x.t}</td><td>${money(x.rev)}</td><td>${money(x.op)}</td><td>${money(x.da)}</td><td>${money(x.ebit)}</td><td>${money(x.tax)}</td><td>${money(x.net)}</td><td>${money(x.capex)}</td><td>${money(x.cf)}</td></tr>`).join('');let metrics=integralMetrics(p,m,res);let scenRows=sc.map(x=>`<tr><td>${x.label}</td><td>${money(x.van)}</td><td>${pct(x.tir)}</td><td>${num(x.bc)}</td></tr>`).join('');return `<section class="card report" id="academicReport"><h2>INFORME DE EVALUACIÓN FINANCIERA</h2><div class="notice"><b>Dictamen preliminar: ${status}</b><br>El resultado es automático y debe interpretarse junto con los supuestos, sensibilidad, estructura de deuda y contexto sectorial.</div><h3>1. Ficha técnica</h3><table><tbody><tr><th>Proyecto</th><td>${esc(p.project)}</td></tr><tr><th>Sector</th><td>${esc(sectorName(p.sector))}</td></tr><tr><th>CIIU</th><td>${esc(p.ciiuInfo.label)}</td></tr><tr><th>Región</th><td>${esc(p.region)}</td></tr><tr><th>Horizonte</th><td>${p.n} años</td></tr><tr><th>WACC</th><td>${pct(p.wacc)}</td></tr></tbody></table><h3>2. Resumen ejecutivo</h3><p>El proyecto presenta un VAN de <b>${money(van)}</b>, una TIR de <b>${pct(tir)}</b> y una TIRM de <b>${pct(tm)}</b>. La lectura de viabilidad se realiza comparando rentabilidad, costo de capital, generación de caja y riesgos de estructura financiera.</p><h3>3. Flujo de caja proyectado</h3><div class="tablewrap"><table><thead><tr><th>Año</th><th>Ingresos</th><th>Costos operativos</th><th>D&A</th><th>EBIT</th><th>Impuesto</th><th>Utilidad neta</th><th>CAPEX</th><th>Flujo</th></tr></thead><tbody>${rows}</tbody></table></div><h3>4. Indicadores financieros</h3>${metricsTable(p,m,res)}<h3>5. Procedimientos matemáticos</h3><p>El informe conserva las fórmulas y sustituciones mostradas en el módulo pedagógico del simulador. La TIR se obtiene mediante Newton-Raphson y utiliza bisección como contraste cuando es necesario.</p>${mathProcedure(p,m,res)}<h3>6. Escenarios</h3><div class="tablewrap"><table><thead><tr><th>Escenario</th><th>VAN</th><th>TIR</th><th>B/C</th></tr></thead><tbody>${scenRows}</tbody></table></div><h3>7. Contexto macroeconómico y sectorial</h3><p>La información DANE se mantiene como evidencia externa de contexto. Los valores observados no se confunden con supuestos financieros del proyecto; estos últimos permanecen editables y trazables.</p><h3>8. Conclusión y recomendación</h3><p><b>Conclusión:</b> ${status==='VIABLE'?'Los indicadores centrales respaldan la generación de valor bajo los supuestos actuales.':'Los resultados requieren ajustes o validación adicional antes de considerar el proyecto financieramente aceptable.'}</p><p><b>Recomendación:</b> revisar especialmente las variables que presenten mayor sensibilidad del VAN y comprobar que los supuestos de ingresos, costos, financiación y demanda sean consistentes con la evidencia sectorial.</p><p class="small">Informe generado por el Simulador Integral de Evaluación Financiera Sectorial. Versión v1.2.</p></section>`;
}
</script></body></html>