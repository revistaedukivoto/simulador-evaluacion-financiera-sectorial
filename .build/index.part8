nity)),lo=Math.min(open,close,x.cf.slice(1).reduce((a,b)=>Math.min(a,b),Infinity));qc.strokeStyle='#334155';qc.lineWidth=2;qc.beginPath();qc.moveTo(px,Y(lo));qc.lineTo(px,Y(hi));qc.stroke();qc.lineWidth=18;qc.strokeStyle=close>=open?'#166534':'#b91c1c';qc.beginPath();qc.moveTo(px,Y(open));qc.lineTo(px,Y(close));qc.stroke();qc.fillStyle='#334155';qc.font='11px Arial';qc.fillText(x.label,px-28,H-8)})}

function buildAcademicReport(p,m,res,sc){
  const van=npv(p.wacc,res.cf), tir=res.irr.r, tm=mirr(res.cf,p.finance,p.reinvest);
  const status=van>0&&tir>p.wacc?'VIABLE':van>0||tir>p.wacc?'CONDICIONADA':'NO VIABLE';
  const rows=res.detail.map(x=>`<tr><td>${x.t}</td><td>${money(x.rev)}</td><td>${money(x.op)}</td><td>${money(x.da)}</td><td>${money(x.ebit)}</td><td>${money(x.tax)}</td><td>${money(x.net)}</td><td>${money(x.capex)}</td><td>${money(x.cf)}</td></tr>`).join('');
  const scenRows=sc.map(x=>`<tr><td>${x.label}</td><td>${money(x.van)}</td><td>${pct(x.tir)}</td><td>${num(x.bc)}</td></tr>`).join('');
  return `<section class="card report" id="academicReport"><h2>INFORME DE EVALUACIÓN FINANCIERA</h2><div class="notice"><b>Dictamen preliminar: ${status}</b><br>El resultado es automático y debe interpretarse junto con los supuestos, sensibilidad, estructura de deuda y contexto sectorial.</div><h3>1. Ficha técnica</h3><table><tbody><tr><th>Proyecto</th><td>${esc(p.project)}</td></tr><tr><th>Sector</th><td>${esc(sectorName(p.sector))}</td></tr><tr><th>CIIU</th><td>${esc(p.ciiuInfo.label)}</td></tr><tr><th>Región</th><td>${esc(p.region)}</td></tr><tr><th>Horizonte</th><td>${p.n} años</td></tr><tr><th>WACC</th><td>${pct(p.wacc)}</td></tr></tbody></table><h3>2. Resumen ejecutivo</h3><p>El proyecto presenta un VAN de <b>${money(van)}</b>, una TIR de <b>${pct(tir)}</b> y una TIRM de <b>${pct(tm)}</b>. La lectura de viabilidad se realiza comparando rentabilidad, costo de capital, generación de caja y riesgos de estructura financiera.</p><h3>3. Flujo de caja proyectado</h3><div class="tablewrap"><table><thead><tr><th>Año</th><th>Ingresos</th><th>Costos operativos</th><th>D&A</th><th>EBIT</th><th>Impuesto</th><th>Utilidad neta</th><th>CAPEX</th><th>Flujo</th></tr></thead><tbody>${rows}</tbody></table></div><h3>4. Indicadores financieros</h3>${metricsTable(p,m,res)}<h3>5. Procedimientos matemáticos</h3><p>El informe conserva las fórmulas y sustituciones mostradas en el módulo pedagógico del simulador. La TIR se obtiene mediante Newton-Raphson y utiliza bisección como contraste cuando es necesario.</p>${mathProcedure(p,m,res)}<h3>6. Escenarios</h3><div class="tablewrap"><table><thead><tr><th>Escenario</th><th>VAN</th><th>TIR</th><th>B/C</th></tr></thead><tbody>${scenRows}</tbody></table></div><h3>7. Contexto macroeconómico y sectorial</h3><p>La información DANE se mantiene como evidencia externa de contexto. Los valores observados no se confunden con supuestos financieros del proyecto; estos últimos permanecen editables y trazables.</p><h3>8. Conclusión y recomendación</h3><p><b>Conclusión:</b> ${status==='VIABLE'?'Los indicadores centrales respaldan la generación de valor bajo los supuestos actuales.':'Los resultados requieren ajustes o validación adicional antes de considerar el proyecto financieramente aceptable.'}</p><p><b>Recomendación:</b> revisar especialmente las variables que presenten mayor sensibilidad del VAN y comprobar que los supuestos de ingresos, costos, financiación y demanda sean consistentes con la evidencia sectorial.</p><p class="small">Informe generado por el Simulador Integral de Evaluación Financiera Sectorial. Versión v1.2.</p></section>`;
}
function openReport(){
  if(!$('output').innerHTML) run();
  const p=inputs(),m=matrix(),res=calc(p,m);let ir=irrNewton(res.cf),br=irrBisection(res.cf);if(!ir.converged&&br!==null)ir.r=br;res.irr=ir;const sc=[scenario(p,m,.85,'Pesimista'),scenario(p,m,1,'Base'),scenario(p,m,1.15,'Optimista')];
  const w=window.open('','_blank'); if(!w){window.print();return;} w.document.write(`<!doctype html><html><head><title>Informe — ${esc(p.project)}</title><style>${document.querySelector('style').innerHTML}</style></head><body><header><h1>Informe de Evaluación Financiera</h1><p>${esc(p.project)} · v1.2</p></header><main class="wrap">${buildAcademicReport(p,m,res,sc)}</main></body></html>`);w.document.close();setTimeout(()=>w.print(),400);
}
function run(){let p=inputs(),m=matrix();if(p.n<1||p.n>10){alert('El horizonte debe estar entre 1 y 10 años.');return}let res=calc(p,m);let ir=irrNewton(res.cf),br=irrBisection(res.cf);if(!ir.converged&&br!==null)ir.r=br;res.irr=ir;let out=$('output');out.innerHTML=render(p,m,res);let sc=[scenario(p,m,.85,'Pesimista'),scenario(p,m,1,'Base'),scenario(p,m,1.15,'Optimista')];requestAnimationFrame(()=>draw(p,res.cf,sc));window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'})}
$('run').addEventListener('click',run);$('pdf').addEventListener('click',openReport);const reportBtn=$('report');if(reportBtn)reportBtn.addEventListener('click',openReport);$('reset').addEventListener('click',()=>location.reload());run();
</script></body></html>
